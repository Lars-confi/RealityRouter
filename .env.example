# RealityRouter - Complete Environment Configuration Template (.env.example)
# Precedence chain: CLI Flags > Process Environment > This File (.env) > Auto-detect > Fallbacks > Prompts (Interactive-only)
# Restart requirement: A server restart is required for any changes in this file to take effect.

# ==========================================
# 1. CORE DIRECTORIES & HOSTS
# ==========================================

# Subsystem: CLI / Server Initialization
# Purpose: Root directory for configuration, sqlite database, logs, and state files.
# Type: String (Path)
# Default: ~/.reality_router
# Secret: No | Persisted: Yes
REALITY_ROUTER_HOME=~/.reality_router

# Subsystem: Server Port / Bind
# Purpose: Network port to bind the FastAPI/Uvicorn server.
# Type: Integer (1-65535)
# Default: 8000 (auto-falls back to next free port if busy)
# Secret: No | Persisted: Yes
REALITY_ROUTER_PORT=8000

# Subsystem: Server Bind Address
# Purpose: Network address to bind the FastAPI/Uvicorn server.
# Type: String (IP Address)
# Default: 0.0.0.0
# Secret: No | Persisted: Yes
REALITY_ROUTER_HOST=0.0.0.0


# ==========================================
# 2. MODEL PROVIDER API KEYS & BASE URLS
# ==========================================

# Subsystem: Provider Adapters (OpenAI)
# Purpose: API key for the OpenAI client adapter.
# Type: String (Secret)
# Default: None
# Secret: Yes | Persisted: Yes
OPENAI_API_KEY=your_openai_api_key_here

# Subsystem: Provider Adapters (Anthropic)
# Purpose: API key for the Anthropic client adapter.
# Type: String (Secret)
# Default: None
# Secret: Yes | Persisted: Yes
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Subsystem: Provider Adapters (Gemini)
# Purpose: API key for Google Gemini native and OpenAI-compatible discovery.
# Type: String (Secret)
# Default: None
# Secret: Yes | Persisted: Yes
GEMINI_API_KEY=your_gemini_api_key_here

# Subsystem: Provider Adapters (Mistral)
# Purpose: API key for Mistral AI client adapter.
# Type: String (Secret)
# Default: None
# Secret: Yes | Persisted: Yes
MISTRAL_API_KEY=your_mistral_api_key_here

# Subsystem: Provider Adapters (DeepSeek)
# Purpose: API key for DeepSeek client adapter.
# Type: String (Secret)
# Default: None
# Secret: Yes | Persisted: Yes
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Subsystem: Provider Adapters (Hugging Face)
# Purpose: API key for Hugging Face Serverless or Dedicated Endpoints.
# Type: String (Secret)
# Default: None
# Secret: Yes | Persisted: Yes
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Subsystem: Provider Adapters (Generic / Local Custom)
# Purpose: Base URL for custom/local OpenAI-compatible endpoints (e.g. Ollama, vLLM, LM Studio).
# Type: String (URL)
# Default: None
# Secret: No | Persisted: Yes
CUSTOM_LLM_BASE_URL=http://localhost:11434/v1

# Subsystem: Provider Adapters (Generic / Local Custom)
# Purpose: API Key placeholder or custom key for local OpenAI-compatible endpoints.
# Type: String (Secret / Placeholder)
# Default: dummy
# Secret: Yes | Persisted: Yes
CUSTOM_LLM_API_KEY=dummy


# ==========================================
# 3. REALITY SIGNAL AUTH & ENDPOINTS
# ==========================================

# Subsystem: Calibration & Remote Validation
# Purpose: Device/OAuth/SSO authorization token used to communicate with the Reality Signal server.
# Type: String (Bearer token)
# Default: None
# Secret: Yes | Persisted: Yes
REALITY_CHECK_TOKEN=your_reality_check_sso_token_here

# Subsystem: Calibration
# Purpose: Authentication provider used (Microsoft, GitHub, Google, CLI).
# Type: String
# Default: None
# Secret: No | Persisted: Yes
REALITY_CHECK_PROVIDER=Microsoft

# Subsystem: Routing Core (Snap)
# Purpose: API endpoint for single-shot expected utility calculations.
# Type: String (URL)
# Default: https://api.realitysignal.com/v1/snap
# Secret: No | Persisted: Yes
REALITY_SIGNAL_SNAP_URL=https://api.realitysignal.com/v1/snap

# Subsystem: Routing Core (Ladder)
# Purpose: API endpoint for sequential escalation calibration.
# Type: String (URL)
# Default: https://api.realitysignal.com/v1/ladder
# Secret: No | Persisted: Yes
REALITY_SIGNAL_LATER_URL=https://api.realitysignal.com/v1/ladder


# ==========================================
# 4. ROUTING COEFFICIENTS & STRATEGY
# ==========================================

# Subsystem: Routing Brain
# Purpose: Pre-selected strategy for dynamic model selection.
# Type: String (expected_utility or tiered_assessment)
# Default: expected_utility
# Secret: No | Persisted: Yes
ROUTING_STRATEGY=expected_utility

# Subsystem: Expected Utility Routing Brain
# Purpose: Cost sensitivity coefficient (alpha). Represents penalty score per dollar.
# Type: Float (0.0 to 100.0)
# Default: 1.0
# Secret: No | Persisted: Yes
COST_SENSITIVITY=1.0

# Subsystem: Expected Utility Routing Brain
# Purpose: Time sensitivity coefficient (beta). Represents penalty score per second of latency.
# Type: Float (0.0 to 100.0)
# Default: 1.0
# Secret: No | Persisted: Yes
TIME_SENSITIVITY=1.0

# Subsystem: Feedback Loop
# Purpose: The fast and cheap model designated for processing sentiment check & feedback loop tasks.
# Type: String (Model ID)
# Default: Auto-selected on discovery
# Secret: No | Persisted: Yes
SENTIMENT_MODEL_ID=gpt-4o-mini


# ==========================================
# 5. USER METADATA (Optional)
# ==========================================

# Subsystem: Metrics / Calibration Feed
# Purpose: User identifier for personalized routing curves.
# Type: String (Email)
# Default: anonymous
# Secret: No | Persisted: Yes
SSO_EMAIL=user@example.com

# Subsystem: Latency Tuning
# Purpose: Geographic location for modeling network latencies to different provider regions.
# Type: String (Country code or region)
# Default: US
# Secret: No | Persisted: Yes
USER_LOCATION=US


# ==========================================
# 6. SYSTEM SECURITY & TLS OVERRIDES
# ==========================================

# Subsystem: Network Client / Discovery Paths
# Purpose: Set to 'true' to allow connection to self-signed enterprise endpoints (disables SSL certificate verification).
# Type: Boolean (true / false)
# Default: false
# Secret: No | Persisted: Yes
# ⚠️ WARNING: Disabling TLS verification exposes connections to Man-In-The-Middle attacks.
INSECURE_SKIP_TLS_VERIFY=false


# ==========================================
# 7. PERFORMANCE, TIMEOUTS, AND LOGGING
# ==========================================

# Subsystem: Request Dispatcher
# Purpose: Maximum request retry attempts on network or downstream provider failures.
# Type: Integer (1 to 10)
# Default: 3
# Secret: No | Persisted: Yes
MAX_RETRIES=3

# Subsystem: Request Dispatcher
# Purpose: Request timeout limit in seconds.
# Type: Float
# Default: 30.0
# Secret: No | Persisted: Yes
REQUEST_TIMEOUT_SEC=30.0

# Subsystem: Logging Subsystem
# Purpose: Detail level for log output (`DEBUG`, `INFO`, `WARNING`, `ERROR`).
# Type: String
# Default: INFO
# Secret: No | Persisted: Yes
LOG_LEVEL=INFO
